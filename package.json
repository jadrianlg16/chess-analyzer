{
  "name": "chess-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "copy:stockfish": "node scripts/copy-stockfish.mjs",
    "predev": "npm run copy:stockfish",
    "prebuild": "npm run copy:stockfish",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stockfish": "18.0.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "$vite"
  }
}
