{
  "name": "chess-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy:stockfish": "node scripts/copy-stockfish.mjs",
    "predev": "npm run copy:stockfish",
    "prebuild": "npm run copy:stockfish",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "chess.js": "1.4.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stockfish": "18.0.7"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
